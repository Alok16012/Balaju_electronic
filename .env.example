VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PUBLIC_SITE_URL=https://www.balajielectronic.in
VITE_PAYMENT_PROVIDER=mock
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=

# QR catalogue CRM (leads, cart activity, favourites, orders).
# Leave both blank to run everything on-device via localStorage.
# Set both to persist to Supabase — run supabase/schema.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin passcode, used ONLY in local mode. It ships inside the browser bundle,
# so it hides the panel rather than securing it. With Supabase configured the
# admin panel signs in against Supabase Auth instead and this is ignored.
VITE_ADMIN_PASSCODE=balaji-admin
